# Copy this file to `.env.local` (gitignored) for local development.
#
# API host:
# - iOS simulator and Expo web default to http://localhost:5000
# - Android emulator defaults to http://10.0.2.2:5000
# - A physical phone must use your computer's LAN IP, for example:
# EXPO_PUBLIC_API_URL=http://192.168.1.60:5000
#
# Only set EXPO_PUBLIC_API_URL when the platform default is not correct.
# EXPO_PUBLIC_API_URL=http://localhost:5000

# Hosted backend (use this for testing against the live Render service).
# EXPO_PUBLIC_API_URL=https://alertu.onrender.com

# Local testing without Firebase credentials.
# Use `dev:` followed by the exact DEV_AUTH_TOKEN value from backend/.env.
# This path is rejected by the backend when NODE_ENV=production.
# Generate the backend token with: openssl rand -hex 32
# EXPO_PUBLIC_DEV_AUTH_TOKEN=dev:replace-with-the-backend-DEV_AUTH_TOKEN

# Firebase client configuration (required for real Firebase Auth).
# The mobile app already derives the project/API values from
# google-services.json. Add the Google OAuth web client ID here after
# enabling Google sign-in in Firebase Authentication.
# EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=000000000000-xxxxxxxx.apps.googleusercontent.com

# Firebase Auth emulator (local Firebase testing only):
# EXPO_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST=http://127.0.0.1:9099
