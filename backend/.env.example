JWT_SECRET=your_secret_key
PORT=port_using

# Comma-separated browser origins allowed to call the API.
# Required in production for the web frontend, for example:
# CORS_ORIGIN=https://alertu.example.com
CORS_ORIGIN=

# Database informations
# DB_NAME takes precedence over the database path in DB_URL/DATABASE_URL.
DB_URL=database_url
DB_USER=database_user
DB_PASSWORD=database_password
DB_NAME=defaultdb
DB_HOST=database_host
DB_PORT=database_port

# Cloudinary for hosting/saving of images sent by user's
CLOUDINARY_CLOUD_NAME=cloudinary_cloud_name
CLOUDINARY_API_KEY=cloudinary_api_key
CLOUDINARY_API_SECRET=cloudinary_api_secret


# FCM & GOOGLE MAPS for push notifications and locations
FIREBASE_PROJECT_ID=your_firebase_project_id
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/firebase-service-account.json
# Alternatively, provide the service-account JSON directly (raw or base64).
# FIREBASE_SERVICE_ACCOUNT_JSON=
PUSH_ENABLED=true
PUSH_PROVIDER=fcm

# Development-only auth for the Expo app. Never enable in production.
# The mobile value is `dev:` followed by this token.
DEV_AUTH_ENABLED=false
DEV_AUTH_TOKEN=replace-with-a-32-byte-random-token
DEV_AUTH_UID=dev-local-user
DEV_AUTH_NAME=AlertU Dev User
DEV_AUTH_EMAIL=dev@alertu.local
# DEV_AUTH_CAMPUS_ID=